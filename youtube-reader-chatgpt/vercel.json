{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": null,
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/health", "destination": "/api/health" },
    { "source": "/selftest", "destination": "/api/selftest" },
    { "source": "/privacy", "destination": "/api/privacy" },
    { "source": "/terms", "destination": "/api/terms" },
    { "source": "/support", "destination": "/api/support" },
    { "source": "/.well-known/openai-apps-challenge", "destination": "/api/openai-apps-challenge" }
  ]
}
